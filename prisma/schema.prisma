generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

/// How a coupon reduces the bill.
/// PERCENT      — `value`% off the eligible subtotal, capped by `maxDiscount`.
/// FIXED        — flat `value` rupees off.
/// FREE_SHIPPING— shipping is zeroed; no line discount.
/// BUY_X_GET_Y  — cheapest `getQty` of every `buyQty + getQty` eligible units free.
enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
  BUY_X_GET_Y
}

/// Shot type for a product photo. Drives the ordered gallery on the PDP —
/// luxury listings run 6-10 images and shoppers expect them in this sequence.
enum ImageKind {
  FRONT
  BACK
  SIDE
  CLOSEUP
  FABRIC
  MODEL
  LIFESTYLE
  OTHER
}

/// Short-form video attached to a product. All are served from Cloudinary.
enum VideoKind {
  REEL
  ROTATION_360
  RAMP_WALK
  DETAIL
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  RECEIVED
  REFUNDED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  name          String?
  image         String?
  role          Role      @default(CUSTOMER)
  /// scrypt digest — null for accounts that only ever used magic-link/Google.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders         Order[]
  wishlist       WishlistItem[]
  addresses      Address[]
  accounts       Account[]
  resetTokens    PasswordResetToken[]
  recentlyViewed RecentlyViewed[]
  reviews        Review[]
  returns        ReturnRequest[]
  savedItems     SavedItem[]
  redemptions    CouponRedemption[]
}

/// Linked OAuth identities (Google). Required by NextAuth's adapter contract
/// for any provider that isn't Credentials or Email.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

/// Single-use password-reset links. Only the SHA-256 of the token is stored,
/// so a database leak can't be replayed as a reset.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Server-side "recently viewed" for signed-in shoppers. Guests keep the same
/// list in localStorage; it is merged into this table on first sign-in.
model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt(sort: Desc)])
}

/// Email sign-in link tokens (NextAuth Email/Resend provider). Rows are
/// created on send and deleted on use — there is no long-lived data here.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  bannerImage String?
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())

  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String
  basePrice    Decimal  @db.Decimal(10, 2)
  /// Pre-discount list price. Null means no discount is shown at all — the
  /// storefront only strikes through a price and renders a % badge when this
  /// is set. Must always be >= the selling price: a compare-at price below
  /// what is actually charged is a data error, not a discount, so the product
  /// schema rejects it rather than advertising a negative saving.
  mrp          Decimal? @db.Decimal(10, 2)
  collectionId String?
  isVisible    Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  tags         String[]

  // --- Fashion attributes -------------------------------------------------
  // Size and colour live on SKU because they drive stock; everything below is
  // a property of the garment itself and is the same across every variant.
  material     String?
  fabric       String?
  sleeve       String?
  neck         String?
  length       String?
  careInstr    String?
  /// Free-text dispatch promise shown on the PDP, e.g. "Ships in 2-4 weeks".
  deliveryTime String?

  // --- Tax ----------------------------------------------------------------
  /// When true (default) the listed price already contains GST and tax is
  /// extracted from it. When false GST is added on top at checkout.
  priceIncludesGst Boolean  @default(true)
  /// Per-product GST override in percent. Null = use the store's price slab.
  gstRate          Decimal? @db.Decimal(5, 2)
  /// Exempt this product from GST entirely (e.g. a gift card).
  gstExempt        Boolean  @default(false)
  hsnCode          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection     Collection?      @relation(fields: [collectionId], references: [id])
  skus           SKU[]
  images         ProductImage[]
  videos         ProductVideo[]
  wishlist       WishlistItem[]
  recentlyViewed RecentlyViewed[]
  reviews        Review[]
}

model SKU {
  id        String  @id @default(cuid())
  productId String
  size      String
  color     String?
  skuCode   String  @unique
  stock     Int     @default(0)
  price     Decimal @db.Decimal(10, 2)
  /// Per-variant pre-discount list price, overriding Product.mrp for sizes
  /// that carry their own. Null means no discount is shown for this variant.
  /// Must always be >= `price`, for the same reason as Product.mrp.
  mrp       Decimal? @db.Decimal(10, 2)
  /// Manual kill-switch. A size is also treated as unbuyable whenever
  /// `stock` hits 0 — that part is derived, never stored (see lib/inventory).
  isActive  Boolean @default(true)
  /// Stock level at or below which the size is flagged "low" in admin + PDP.
  lowStockAt Int    @default(3)
  sortOrder  Int    @default(0)

  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  savedItems SavedItem[]

  @@index([productId])
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  url       String
  altText   String?
  kind      ImageKind @default(OTHER)
  sortOrder Int       @default(0)
  isPrimary Boolean   @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Product video (Cloudinary). Reels and 360° spins lift conversion far more
/// than an extra still, so they are first-class rather than an image variant.
model ProductVideo {
  id          String    @id @default(cuid())
  productId   String
  url         String
  publicId    String?
  posterUrl   String?
  kind        VideoKind @default(REEL)
  durationSec Int?
  sortOrder   Int       @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// "Save for later" — a parked cart line. Distinct from WishlistItem, which is
/// product-level and has no size; this remembers the exact variant and qty.
model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  skuId     String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku  SKU  @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([userId, skuId])
  @@index([userId])
}

model Cart {
  id        String   @id @default(cuid())
  sessionId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id       String @id @default(cuid())
  cartId   String
  skuId    String
  quantity Int    @default(1)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku  SKU  @relation(fields: [skuId], references: [id])

  @@unique([cartId, skuId])
}

model Order {
  id     String      @id @default(cuid())
  userId String
  status OrderStatus @default(PENDING)

  // --- Money breakdown ----------------------------------------------------
  // Every component is snapshotted so an old invoice never changes when tax
  // rates, shipping rules or coupons are edited later.
  /// Sum of line prices as listed, before any discount.
  subtotal      Decimal @default(0) @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @db.Decimal(10, 2)
  shippingTotal Decimal @default(0) @db.Decimal(10, 2)
  /// GST across all lines. Included inside `subtotal` when the store prices
  /// tax-inclusive; added on top otherwise.
  taxTotal      Decimal @default(0) @db.Decimal(10, 2)
  /// Grand total actually charged.
  totalAmount   Decimal @db.Decimal(10, 2)
  couponId      String?
  /// Snapshot of the code as typed, kept even if the coupon is later deleted.
  couponCode    String?

  addressId         String
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  paymentMethod     String?
  notes             String?
  /// Courier waybill / AWB number, set by staff once the parcel is handed over.
  trackingNumber    String?
  carrier           String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user        User               @relation(fields: [userId], references: [id])
  items       OrderItem[]
  address     Address            @relation(fields: [addressId], references: [id])
  events      OrderEvent[]
  returns     ReturnRequest[]
  reviews     Review[]
  coupon      Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]

  @@index([userId])
  @@index([status])
  @@index([trackingNumber])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  skuId     String
  quantity  Int
  /// Unit price at the time of purchase, as listed on the storefront.
  priceSnap Decimal @db.Decimal(10, 2)
  /// Share of the order discount attributed to this line — needed so the
  /// invoice and any partial refund add back up to the amount charged.
  discount  Decimal @default(0) @db.Decimal(10, 2)
  /// GST rate applied to this line, in percent.
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(10, 2)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         SKU          @relation(fields: [skuId], references: [id])
  returnItems ReturnItem[]
}

/// Discount code. Admin-authored; validated server-side on every quote and
/// again inside the order transaction, so a code can never be over-redeemed.
model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  description String?
  type        DiscountType

  /// PERCENT: 0-100. FIXED: rupees off. Unused by the other types.
  value       Decimal  @default(0) @db.Decimal(10, 2)
  /// Ceiling on a PERCENT discount, in rupees. Null = uncapped.
  maxDiscount Decimal? @db.Decimal(10, 2)
  /// Cart subtotal the order must reach before the code applies.
  minOrder    Decimal? @db.Decimal(10, 2)

  /// BUY_X_GET_Y only — buy `buyQty`, get `getQty` cheapest units free.
  buyQty Int?
  getQty Int?

  startsAt  DateTime?
  expiresAt DateTime?
  /// Total redemptions allowed across all customers. Null = unlimited.
  usageLimit   Int?
  /// Redemptions allowed per customer. Null = unlimited.
  perUserLimit Int?    @default(1)
  usageCount   Int     @default(0)
  isActive     Boolean @default(true)
  /// Only redeemable on a customer's first order.
  firstOrderOnly Boolean @default(false)

  /// Restrict eligibility. Both empty = the whole catalogue qualifies.
  collectionIds String[]
  productIds    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]

  @@index([isActive, expiresAt])
}

/// One row per successful use. The unique pair is what makes redemption
/// idempotent when the Razorpay webhook and the client verify both fire.
model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
}

/// Single-row store configuration (id is always "default"). Keeps tax and
/// shipping rules editable from admin instead of hardcoded in the bundle.
model StoreSetting {
  id String @id @default("default")

  gstEnabled       Boolean @default(true)
  /// Default for new products: are listed prices GST-inclusive?
  pricesIncludeGst Boolean @default(true)
  /// Indian apparel GST is slab-based on the per-piece price.
  gstLowRate       Decimal @default(5) @db.Decimal(5, 2)
  gstHighRate      Decimal @default(18) @db.Decimal(5, 2)
  gstSlabThreshold Decimal @default(2500) @db.Decimal(10, 2)

  shippingFlat          Decimal @default(299) @db.Decimal(10, 2)
  freeShippingThreshold Decimal @default(5000) @db.Decimal(10, 2)
  codFee                Decimal @default(0) @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt
}

/// Append-only shipping/status timeline shown on the order-tracking page. One
/// row per transition; the order's own `status` stays the current-state cache.
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  message   String?
  location  String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// A customer-initiated return for part or all of a delivered order.
model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  userId       String
  status       ReturnStatus @default(REQUESTED)
  reason       String
  comment      String?
  /// Set by staff when the refund is issued; null until then.
  refundAmount Decimal?     @db.Decimal(10, 2)
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ReturnItem[]

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model ReturnItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnRequestId, orderItemId])
}

/// Product review. Limited to one per product per customer, and only writable
/// by someone who actually received that product (checked in the API layer).
model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  /// The delivered order that entitled this review — kept for provenance.
  orderId   String?
  rating    Int
  title     String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([productId, createdAt(sort: Desc)])
  @@index([userId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  name       String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  phone      String
  isDefault  Boolean @default(false)
  /// Removed from the customer's address book but kept intact because past
  /// orders point at it. Archived rows are never shown or reused.
  isArchived Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model WishlistItem {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model OtpToken {
  id        String   @id @default(cuid())
  phone     String
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}
