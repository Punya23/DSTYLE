# ─────────────────────────────────────────────────────────────────────────────
# Dstyle environment variables
#
# Local dev: copy this file to `.env` and fill in real values.
# Vercel:    add every variable below in Project → Settings → Environment
#            Variables, then REDEPLOY (env changes don't affect existing builds).
#
# ⚠️  `.env` is gitignored, so it is NOT deployed — Vercel only has what you add
#     in its dashboard. A missing DATABASE_URL is why the store shows "0 pieces".
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED — without this the store shows no products) ────────────
# On Vercel (serverless) you MUST use Neon's POOLED connection string — the host
# has "-pooler" in it. The direct/non-pooled URL exhausts connections and fails.
# Neon dashboard → Connect → turn ON "Connection pooling" → copy that string.
#   direct : ...@ep-xxxx.<region>.aws.neon.tech/neondb?sslmode=require
#   pooled : ...@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require   ← use this on Vercel
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# ── Auth (REQUIRED for login) ────────────────────────────────────────────────
# On Vercel, set these to your deployed domain, e.g. https://your-app.vercel.app
# Sign-in methods: email + password, email magic-link, and (optionally) Google.
# All three send mail through Resend, so RESEND_API_KEY below is required.
# NEXTAUTH_SECRET must be a real generated secret, not this placeholder.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ── Google sign-in (optional) ────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Authorised redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google        (local)
#   https://<your-domain>/api/auth/callback/google        (production)
# Leave both unset and the Google button simply doesn't render — the app
# reads NextAuth's own provider list rather than a separate feature flag.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── AI (Groq) — powers the stylist + admin insights ──────────────────────────
# https://console.groq.com/keys  (unset → keyword stylist / rule-based insights)
GROQ_API_KEY="gsk_..."
# GROQ_MODEL="llama-3.3-70b-versatile"

# ── App URLs — set to the Vercel domain in production ─────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@dstyle.in"

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"

# ── Image uploads (Cloudinary) — admin product photos ────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Email (Resend) — REQUIRED: this is how customers sign in ────────────────
# https://resend.com/api-keys (free tier). Carries magic links, registration
# verification, and password-reset links. Without a real key those emails are
# printed to the server console in development and hard-fail in production.
RESEND_API_KEY="your-resend-api-key"
FROM_EMAIL="noreply@dstyle.in"
# Where contact-form enquiries land. Falls back to ADMIN_EMAIL, then to the
# support address compiled into src/lib/company.ts.
SUPPORT_EMAIL="care@dstyle.in"

# ── SMS / WhatsApp (optional, dormant) ───────────────────────────────────────
# Phone-OTP sign-in is coded but not shown in the UI. Add real Twilio creds
# and re-add the phone step to AuthModal.tsx to bring it back.
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
INTERAKT_API_KEY="your-interakt-api-key"

# ── Redis (Upstash) — rate limiting + shared cache (strongly recommended) ────
# Provision with: vercel integration add upstash/upstash-kv
# (a one-time marketplace terms acceptance in the browser is required first).
#
# Without these, src/lib/redis.ts returns null and the app still runs, but:
#   • rate limiting falls back to a PER-INSTANCE in-memory counter, which is
#     leaky across serverless instances — an attacker gets one budget per warm
#     instance rather than one overall;
#   • the /api/products and /api/collections cache becomes a pass-through.
# The Vercel integration may inject these under the KV_ prefix instead; both
# naming schemes are accepted.
UPSTASH_REDIS_REST_URL="your-upstash-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ── Error monitoring (Sentry) — optional ─────────────────────────────────────
# Provision with: vercel integration add sentry
# With no DSN, Sentry.init() is a no-op — nothing breaks, nothing is reported.
# Sentry is also disabled outside production so hot-reload errors aren't sent.
SENTRY_DSN="your-sentry-dsn"
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn"

# Only needed to upload source maps at build time, so stack traces are readable.
# next.config.ts skips the Sentry build plugin entirely unless all three are set.
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# Vercel Analytics and Speed Insights need no configuration — the components in
# app/layout.tsx are inert off Vercel and activate automatically once deployed.
